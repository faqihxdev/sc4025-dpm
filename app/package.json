{
  "name": "sc4025-drink-finder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4177",
    "dev:api": "node scripts/prepare-chat-env.mjs && npx wrangler@4.146.0 pages dev dist --ip 127.0.0.1 --port 8788 --compatibility-date 2026-10-03 --log-level error",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4177",
    "test": "vitest run",
    "test:env": "node --test scripts/prepare-chat-env.test.mjs",
    "test:api-local": "node scripts/check-chat-proxy.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "images:prepare": "node scripts/prepare-images.mjs",
    "check:size": "node scripts/check-size.mjs"
  },
  "dependencies": {
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
